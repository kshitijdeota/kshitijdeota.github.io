---
import Base from '../../layouts/Base.astro';
import { work, getWork, categoryLabel } from '../../data/work';
import { p } from '../../utils/base';

export function getStaticPaths() {
  return work.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
---

<Base title={w.title} description={w.excerpt}>
  <div class="page-head" style="padding-bottom: 2.5rem">
    <div class="container" style="max-width: 900px">
      <a href={p('/work/')} class="dim" style="font-size: 0.9rem">← All work</a>
      <div class="badges" style="margin-top: 1.25rem">
        <span class="badge">{categoryLabel[w.category]}</span>
        <span class="badge">{w.year}</span>
      </div>
      <h1 style="margin-top: 0.75rem">{w.title}</h1>
      <p class="lead">{w.excerpt}</p>
    </div>
  </div>

  <section class="section" style="padding-top: 0">
    <div class="container" style="max-width: 900px">
      <img src={p(w.featured)} alt={`${w.title} — featured artwork`} style="border-radius: 16px; border: 1px solid var(--border)" />
      <p class="dim" style="margin-top: 1.5rem">
        Full case study in progress. In the meantime, ask anything —
        <a href="mailto:dev@kdpixels.com" style="color: var(--accent)">dev@kdpixels.com</a>
      </p>
    </div>
  </section>
</Base>
