---
import Base from '../../layouts/Base.astro';
import { apps, priceLabel, seriesMeta } from '../../data/apps';
import { site } from '../../data/site';
import { upcoming } from '../../data/upcoming';
import { metricFor, headlineRating, formatInstalls, metricsAsOf } from '../../data/metrics';
import { p } from '../../utils/base';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.name} apps on Google Play`,
  itemListElement: apps.map((app, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: app.name,
    url: `https://kdpixels.com/apps/${app.slug}/`,
  })),
};

const seriesOrder = ['monoic', 'glass'] as const;
const bySeries = Object.fromEntries(
  seriesOrder.map((s) => [s, apps.filter((a) => a.series === s)])
);
---

<Base title="Apps — Android icon packs on Google Play" jsonld={jsonld}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Catalogue</span>
      <h1>Two series, one studio</h1>
      <p class="lead">
        Every design below is live on Google Play under the same developer name —
        built around real launchers, real icon coverage, and steady updates.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {seriesOrder.map((key) => (
        <div id={key} style="margin-bottom: 3.5rem">
          <h2>{seriesMeta[key].label}</h2>
          <p class="dim" style="max-width: 50ch">{seriesMeta[key].blurb}</p>
          <div class="card-grid" style="margin-top: 1.5rem">
            {bySeries[key].map((app) => (
              <a class="card" href={p(`/apps/${app.slug}/`)}>
                <div class="app-art" style={`background: linear-gradient(135deg, hsl(${app.hue} 35% 16%), hsl(${app.hue} 45% 8%))`}>
                  <div class="tile">{app.kind === 'mask' ? '◑' : '◐'}</div>
                </div>
                <div class="card-body">
                  <div class="title">{app.name}</div>
                  <p>{app.tagline}</p>
                  <div class="badges">
                    {(() => {
                      const m = metricFor(app.pkg);
                      const rating = headlineRating(m, app.rating);
                      const installs = formatInstalls(m?.installs) ?? app.downloads;
                      return (
                        <>
                          {rating != null && (
                            <span class="badge highlight">★ {rating.toFixed(1)}</span>
                          )}
                          <span class="badge">{installs}</span>
                          {app.kind === 'mask' && <span class="badge">Icon mask</span>}
                          <span class="badge">{priceLabel(app)}</span>
                        </>
                      );
                    })()}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}

      <h2 style="margin-top: 3.5rem" id="upcoming">In development</h2>
      <p class="dim" style="max-width: 50ch">
        On the bench right now — this catalogue grows next.
      </p>
      <div class="card-grid" style="margin-top: 1.5rem">
        {upcoming.map((u) => (
          <div class="card">
            <div class="app-art" style={`background: linear-gradient(135deg, hsl(${u.hue} 35% 16%), hsl(${u.hue} 45% 8%))`}>
              <div class="tile">{u.family === 'monoic' ? '◐' : '◆'}</div>
            </div>
            <div class="card-body">
              <div class="badges" style="margin-bottom: 0.6rem">
                <span class="badge highlight">{u.status}</span>
              </div>
              <div class="title">{u.name}</div>
              <p>{u.tagline}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
